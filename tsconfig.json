{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "@/*": [
        "./*"
      ],
      "@shared/*": [
        "./shared/*"
      ]
    },
    "types": [
      "node",
      "mocha",
      "@wdio/globals/types"
    ]
  },
  "include": [
    "tests/**/*.ts",
    "shared/**/*.ts",
    "scripts/**/*.ts",
    "wdio.web.conf.ts",
    "wdio.conf.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "node_modules",
    "reports",
    "playwright-report"
  ]
}
