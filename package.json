{
  "name": "test-automation-hub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Unified TypeScript testing framework for Web, App and API",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test:web": "corepack pnpm run test:web:wdio",
    "test:web:wdio": "corepack pnpm exec wdio run ./wdio.web.conf.ts",
    "test:mobile": "corepack pnpm exec tsx ./scripts/run-mobile.ts",
    "test:unit": "corepack pnpm exec tsx ./scripts/run-unit.ts",
    "test:e2e": "corepack pnpm exec tsx ./scripts/run-e2e.ts",
    "test:all": "corepack pnpm exec tsx ./scripts/run-all.ts",
    "test:report": "corepack pnpm exec tsx ./scripts/report.ts",
    "lint": "corepack pnpm exec eslint .",
    "lint:fix": "corepack pnpm exec eslint . --fix",
    "format": "corepack pnpm exec prettier --write .",
    "clean": "corepack pnpm exec tsx ./scripts/clean.ts",
    "typecheck": "corepack pnpm exec tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/js-yaml": "^4.0.9",
    "@types/mocha": "latest",
    "@types/node": "latest",
    "@wdio/appium-service": "latest",
    "@wdio/cli": "latest",
    "@wdio/globals": "latest",
    "@wdio/junit-reporter": "latest",
    "@wdio/local-runner": "latest",
    "@wdio/mocha-framework": "latest",
    "@wdio/spec-reporter": "latest",
    "@wdio/types": "latest",
    "appium": "latest",
    "appium-uiautomator2-driver": "latest",
    "cross-env": "latest",
    "dotenv": "latest",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "latest",
    "eslint-plugin-vitest": "latest",
    "js-yaml": "^4.1.1",
    "prettier": "latest",
    "ts-node": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vitest": "latest",
    "webdriverio": "latest"
  }
}
