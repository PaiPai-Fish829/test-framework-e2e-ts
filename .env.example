WEB_BASE_URL=https://www.baidu.com
API_BASE_URL=https://jsonplaceholder.typicode.com
API_TOKEN=
SEARCH_ENGINE=baidu

# 平台配置
MOBILE_PLATFORM=android

# Appium Server 配置
APPIUM_HOST=127.0.0.1
# Appium 服务端口（不是 ADB 端口）
# Windows 上 Hyper-V 常保留 4711-4810，4723 会 EACCES，建议使用 5100
APPIUM_PORT=5100

# MuMu 模拟器 ADB 配置（端口以 adb devices 为准，常见 7555 或 5555）
ANDROID_DEVICE_NAME=MuMu Emulator
ANDROID_ADB_PORT=5555
# Appium UiAutomator2 系统端口（默认 8200 在 Windows 保留段内，建议 8500）
ANDROID_SYSTEM_PORT=8500

# 当前待测 App（与 wdio.conf.ts capabilities 一致）
# TP-Link：tplink-login.spec.ts
ANDROID_APP_PACKAGE=com.tplink.ipc
# 启动 Activity 需与本机安装包一致，可用下列命令查询：
# adb -s 127.0.0.1:<ADB端口> shell cmd package resolve-activity --brief com.tplink.ipc
ANDROID_APP_ACTIVITY=com.tplink.superapp.ui.main.AppBootActivity

# 系统设置 App：android-settings-device-info.spec.ts 时改为：
# ANDROID_APP_PACKAGE=com.android.settings
# ANDROID_APP_ACTIVITY=.Settings

IOS_DEVICE_NAME=iPhone 15
IOS_PLATFORM_VERSION=17.5
IOS_BUNDLE_ID=com.apple.Preferences

# Session 是否保留 App 数据（登录态、缓存）
# TP-Link 登录流程建议 false；只读设置页信息可用 true
ANDROID_NO_RESET=false
ANDROID_FULL_RESET=false

# TP-Link 登录账号（仅写在本地 .env，勿提交 Git；正例用例从此读取）
# 反例账号/密码见 shared/fixtures/tplink-login.cases.yaml
TPLINK_USERNAME=
TPLINK_PASSWORD=
